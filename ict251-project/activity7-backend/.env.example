# Copy this file to .env. Never commit .env.

# Browser origins allowed to call this API, comma separated, no trailing slash.
# Add your hosted frontend address here in Activity 8.
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Optional: shown on the API guide page.
PROJECT_NAME=Campus Maintenance Requests
STUDENT_NUMBER=202501509
# PUBLIC_URL=https://your-backend.onrender.com

# Optional: where the SQLite file lives (default: data/maintenance.db).
# On Render with a persistent disk, point this at the disk, e.g. /var/data/maintenance.db
# DB_PATH=data/maintenance.db

# The host sets PORT itself. Only needed locally if 3000 is busy.
# PORT=3000
